FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_PORT=3855

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-asap

# PostgreSQL database connection
# Format: postgresql+psycopg://username:password@host:port/database
# Example: postgresql+psycopg://postgres:your_password@localhost:5432/contractorchatbot
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/contractorchatbot

# Password hashing cost factor
BCRYPT_LOG_ROUNDS=12

# Maximum upload size in bytes (25 MB default)
MAX_CONTENT_LENGTH=26214400




