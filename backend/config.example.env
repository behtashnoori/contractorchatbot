FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_PORT=8000

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-asap

# PostgreSQL database connection
# Format: postgresql+psycopg://username:password@host:port/database
# Example: postgresql+psycopg://postgres:your_password@localhost:5432/contractorchatbot
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/contractorchatbot

# Password hashing cost factor
BCRYPT_LOG_ROUNDS=12

# Maximum upload size in bytes (25 MB default)
MAX_CONTENT_LENGTH=26214400

# CORS allowed origins (comma-separated). Required in production (FLASK_ENV=production).
# Local dev: if unset, defaults to localhost:5173 and :3000.
# Example: "http://192.168.1.100:3000,https://example.com"
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional root log level for Python logging (default INFO outside debug)
LOG_LEVEL=INFO

# KPI microservice (api/): required for /api/kpi/* and /kpi — send as Authorization: Bearer ... or X-API-Key
KPI_API_KEY=

# KPI Postgres (api/db.py): database password (no default)
PGPASSWORD=

