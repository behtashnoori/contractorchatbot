FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_PORT=8000

# --- Required (application refuses to start if missing, empty, or unsafe) ---
# SECRET_KEY / JWT_SECRET_KEY: each must be >= 32 characters and not a known placeholder.
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<SECRET_KEY>
JWT_SECRET_KEY=<JWT_SECRET_KEY>

# PostgreSQL database connection (required)
# Format: postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=<DATABASE_URL>

# Comma-separated browser origins allowed by CORS (required; at least one origin)
# Production: replace these with exact HTTPS frontend origins. Do not use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# JWT lifetimes in seconds. Keep access tokens short; rotate secrets outside the repo.
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# Password hashing cost factor
BCRYPT_LOG_ROUNDS=12

# Maximum upload size in bytes (25 MB default)
MAX_CONTENT_LENGTH=26214400

# Optional root log level for Python logging (default INFO outside debug)
LOG_LEVEL=INFO

# KPI microservice (api/): required for /api/kpi/* and /kpi — use Authorization: Bearer or X-API-Key (not query string)
KPI_API_KEY=<KPI_API_KEY>

# KPI Postgres (api/db.py): database password (no default)
PGPASSWORD=<DB_PASSWORD>
